#!/bin/sh
# office-win: open the agent office in its own compact Ghostty window (full pixel graphics via the Kitty protocol).
# Usage: office-win [demo]
BIN="$(command -v office || echo "$HOME/.cargo/bin/office")"
exec open -na Ghostty --args \
  --title="ROSSO" \
  --window-width=110 --window-height=34 \
  --font-size=11 \
  --window-padding-x=0 --window-padding-y=0 \
  -e "$BIN" "$@"
